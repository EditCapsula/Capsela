# Gabarit des variables d'environnement — copier en .env.local pour le
# développement, et reporter les mêmes clés chez l'hébergeur pour la
# production. Ce fichier ne contient aucune valeur réelle et est le seul
# .env versionné (cf. .gitignore).
#
# Le préfixe NEXT_PUBLIC_ signifie « lisible depuis le navigateur ». Ces
# valeurs-là ne sont jamais des secrets : elles partent dans le bundle
# client, par conception. Les autres ne doivent jamais y figurer.

# --- Supabase (obligatoire) -------------------------------------------
# Sans ces deux variables, l'app démarre en mode démo : aucun compte réel,
# aucune persistance serveur.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Météo (optionnel) ------------------------------------------------
# Proxy /api/weather vers OpenWeatherMap. Sans clé, la route répond 501 et
# l'app retombe sur la liste de villes simulée, sans erreur bloquante.
# Volontairement sans préfixe public : cette clé reste côté serveur.
OPENWEATHER_API_KEY=

# --- Surveillance des erreurs (optionnel) -----------------------------
# Sans DSN, le SDK Sentry n'est pas initialisé du tout.
# Pense à activer « Prevent Storing of IP Addresses » côté projet Sentry :
# le code n'envoie pas l'IP, mais seul ce réglage garantit sa non-conservation.
NEXT_PUBLIC_SENTRY_DSN=

# Cartes de source : transforment une pile minifiée en numéros de ligne du
# vrai code. Le plugin de build n'est activé que si les TROIS sont
# présentes — sinon `npm run build` passe normalement, comme en CI.
# SENTRY_AUTH_TOKEN est un vrai secret : jamais dans le dépôt.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Mesure d'audience (optionnel) ------------------------------------
# Identifiant de flux Web GA4, au format G-XXXXXXXXXX. Sans lui, aucun
# script Google n'est chargé et le bandeau de consentement ne s'affiche pas.
NEXT_PUBLIC_GA_ID=
